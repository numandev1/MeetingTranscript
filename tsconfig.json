{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "types": ["chrome"],
    "rootDir": "src",
    "baseUrl": ".",
    "paths": {
      "@lib/*": ["src/lib/*"]
    },
    "allowJs": false,
    "resolveJsonModule": true
  },
  "include": ["src/**/*.ts"]
}
